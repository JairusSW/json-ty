{
  "name": "json-ty",
  "version": "0.0.0",
  "author": "Jairus Tanaka <me@jairus.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JairusSW/json-ty.git"
  },
  "main": "dist/src/index.js",
  "types": "src/index.ts",
  "description": "Schema-specialized JSON.parse and JSON.stringify for TypeScript, generated as raw UTF-8 WebAssembly",
  "funding": "https://github.com/sponsors/JairusSW",
  "files": [
    "dist/src/index.js",
    "src/index.ts",
    "assembly/",
    "!assembly/__tests__/",
    "!assembly/wasm/",
    "src/raw/index.js",
    "src/raw/index.d.ts",
    "src/raw/node-binding.js",
    "src/raw/view-state.js",
    "src/raw/browser-binding.js",
    "src/raw/browser-binding.d.ts",
    "dist/compiler/",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CONTRIBUTORS.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "bench/README.md",
    "benchmark/charts/overview-deserialize.svg",
    "benchmark/charts/overview-serialize.svg",
    "benchmark/charts/json-as-parity-parse.svg",
    "benchmark/charts/json-as-parity-serialize.svg",
    "benchmark/charts/classic-v8-deserialize.svg",
    "benchmark/charts/classic-v8-serialize.svg",
    "ARCHITECTURE.md",
    "FEATURE_MATRIX.md"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js"
    },
    "./raw": {
      "types": "./src/raw/index.d.ts",
      "import": "./src/raw/index.js"
    },
    "./browser": {
      "types": "./src/raw/browser-binding.d.ts",
      "import": "./src/raw/browser-binding.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "import": "./dist/compiler/index.js"
    },
    "./transform": {
      "types": "./dist/compiler/ts-patch.d.ts",
      "import": "./dist/compiler/ts-patch.js",
      "default": "./dist/compiler/ts-patch.js"
    }
  },
  "bin": {
    "json-tyc": "./dist/compiler/cli.js"
  },
  "dependencies": {
    "assemblyscript": "^0.28.2",
    "ts-patch": "^4.0.1",
    "xjb-as": "^0.1.0"
  },
  "peerDependencies": {
    "typescript": ">=6.0.2 <7"
  },
  "devDependencies": {
    "@assemblyscript/wasi-shim": "^0.1.0",
    "@types/benchmark": "^2.1.5",
    "@types/node": "^24.0.8",
    "assemblyscript-prettier": "^3.0.1",
    "benchmark": "^2.1.4",
    "benny": "^3.7.1",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "esm": "^3.2.25",
    "fast-json-stringify": "^6.0.1",
    "flatted": "^3.3.3",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "utf-as": "^0.1.1"
  },
  "bugs": {
    "url": "https://github.com/JairusSW/json-ty/issues"
  },
  "contributors": [
    "Jairus Tanaka <me@jairus.dev>"
  ],
  "homepage": "https://github.com/JairusSW/json-ty#readme",
  "keywords": [
    "json",
    "serialize",
    "deserialize",
    "parse",
    "stringify",
    "performance",
    "dynamic",
    "serde",
    "optimized",
    "fast",
    "algorithm",
    "typescript",
    "webassembly",
    "wasm",
    "simd",
    "assemblyscript"
  ],
  "license": "MIT",
  "scripts": {
    "ci": "act",
    "test": "npm run test:raw && npm run test:compiler",
    "test:all": "npm test && npm run test:rfc-oracle && npm run test:fuzz:raw:tiers",
    "bench": "bash ./scripts/run-bench.sh && bash ./scripts/build-charts.sh",
    "bench:run": "bash ./scripts/run-bench.sh",
    "bench:charts": "bash ./scripts/build-charts.sh",
    "bench:all": "npm run bench:tiers && npm run bench:swar-port && npm run bench:charts",
    "bench:swar-port": "npm run bench:swar-port:primitives && npm run bench:swar-port:scanner && npm run bench:swar-port:string && npm run bench:swar-port:integer && npm run bench:swar-port:float && npm run bench:swar-port:arrays && npm run bench:swar-port:document && npm run bench:swar-port:serialize-string",
    "bench:overview": "bash ./scripts/run-bench.sh && bash ./scripts/build-charts.sh",
    "bench:obj": "npm run build:compiler && node ./scripts/build-overview-runtime.mjs && JSON_TY_OVERVIEW_FILTER=small,medium,large node ./bench/overview.bench.mjs && node ./scripts/check-json-obj-threshold.mjs",
    "bench:classic": "npm run bench:classic:run && npm run bench:classic:charts",
    "bench:classic:run": "npm run build:compiler && node ./scripts/build-classic-runtime.mjs && node ./bench/classic.bench.mjs",
    "bench:classic:v8": "npm run build:compiler && JSON_TY_KERNEL_TIER=simd node ./scripts/build-classic-runtime.mjs && node ./bench/classic-v8-projections.test.mjs && node ./scripts/run-classic-v8.mjs && node ./scripts/check-classic-v8-threshold.mjs && node ./scripts/check-classic-dynamic-threshold.mjs && node ./scripts/check-classic-json-as-threshold.mjs && node ./scripts/check-classic-v8-serialize-threshold.mjs && node ./scripts/build-classic-charts.mjs",
    "bench:classic:charts": "node ./scripts/build-classic-charts.mjs",
    "bench:classic:smoke": "npm run build:compiler && node ./scripts/build-classic-runtime.mjs && JSON_TY_CLASSIC_REPORT=build/logs/classic-smoke.json JSON_TY_CLASSIC_FILTER=twitter,canada,poet JSON_TY_CLASSIC_MAX_BYTES=4000000 JSON_TY_BENCH_MS=25 node ./bench/classic.bench.mjs",
    "bench:raw": "npm run build:raw && node ./bench/raw-flat.bench.mjs",
    "bench:tiers": "node ./scripts/run-kernel-tier-harness.mjs",
    "bench:tiers:smoke": "JSON_TY_TIER_HARNESS_SCOPE=smoke node ./scripts/run-kernel-tier-harness.mjs",
    "bench:parity": "npm run build:compiler && node ./scripts/build-parity-runtime.mjs && node ./bench/json-as-parity.bench.mjs",
    "bench:lazy": "npm run build:compiler && node ./scripts/build-parity-runtime.mjs && node ./bench/lazy.bench.mjs",
    "typecheck": "tsc -p ./tsconfig.json --noEmit && tsc -p ./compiler --noEmit",
    "check": "npm run typecheck && npm run test:all",
    "build": "npm run build:typescript && npm run build:compiler",
    "build:typescript": "tsc -p ./tsconfig.json",
    "build:compiler": "tsc -p ./compiler",
    "build:project": "npm run build:compiler && node ./dist/compiler/cli.js",
    "build:raw": "npm run build:compiler && node ./scripts/build-raw-runtime.mjs",
    "test:raw": "npm run build:typescript && npm run build:raw && node ./src/raw/wasm-contract.test.mjs && node ./src/raw/node-binding.test.mjs && node ./src/raw/browser-binding.test.mjs && node ./src/raw/rfc.test.mjs",
    "test:rfc-oracle": "npm run build:compiler && npm run test:rfc-oracle:naive && npm run test:rfc-oracle:swar && npm run test:rfc-oracle:simd",
    "test:rfc-oracle:naive": "JSON_TY_KERNEL_TIER=naive node ./scripts/build-rfc-oracle-runtime.mjs && JSON_TY_KERNEL_TIER=naive node ./src/raw/rfc-oracle.test.mjs",
    "test:rfc-oracle:swar": "JSON_TY_KERNEL_TIER=swar node ./scripts/build-rfc-oracle-runtime.mjs && JSON_TY_KERNEL_TIER=swar node ./src/raw/rfc-oracle.test.mjs",
    "test:rfc-oracle:simd": "JSON_TY_KERNEL_TIER=simd node ./scripts/build-rfc-oracle-runtime.mjs && JSON_TY_KERNEL_TIER=simd node ./src/raw/rfc-oracle.test.mjs",
    "test:compiler": "npm run build:compiler && node ./compiler/src/program-analyzer.test.mjs && node ./compiler/src/call-transformer.test.mjs && node ./compiler/src/assembly-codegen.test.mjs && node ./compiler/src/kernel-tier.test.mjs && node ./compiler/src/build.test.mjs && node ./compiler/src/wide-schema.test.mjs && node ./compiler/src/ts-patch.test.mjs",
    "build:swar-port:primitives": "asc assembly/__tests__/swar-primitives.ts --runtime stub --exportRuntime --optimizeLevel 3 --shrinkLevel 0 -o build/swar-port/primitives.wasm",
    "test:swar-port:primitives": "npm run build:swar-port:primitives && node ./assembly/__tests__/swar-primitives.test.mjs",
    "bench:swar-port:primitives": "npm run build:swar-port:primitives && node ./assembly/__tests__/swar-primitives.bench.mjs",
    "build:swar-port:scanner": "asc assembly/__tests__/structural-scanner.ts --runtime stub --exportRuntime --optimizeLevel 3 --shrinkLevel 0 -o build/swar-port/structural-scanner.wasm",
    "test:swar-port:scanner": "npm run build:swar-port:scanner && node ./assembly/__tests__/structural-scanner.test.mjs && npm run test:swar-port:scanner:simd",
    "test:swar-port:scanner:simd": "asc assembly/__tests__/simd-structural-scanner.ts --runtime stub --exportRuntime --enable simd --optimizeLevel 3 --shrinkLevel 0 -o build/swar-port/simd-structural-scanner.wasm && node ./assembly/__tests__/simd-structural-scanner.test.mjs",
    "bench:swar-port:scanner": "npm run build:swar-port:scanner && node ./assembly/__tests__/structural-scanner.bench.mjs",
    "test:swar-port": "npm run test:swar-port:primitives && npm run test:swar-port:scanner && npm run test:swar-port:string && npm run test:swar-port:integer && npm run test:swar-port:float && npm run test:swar-port:arrays && npm run test:swar-port:document && npm run test:swar-port:serialize-string",
    "build:swar-port:string": "asc assembly/__tests__/swar-string.ts --runtime stub --exportRuntime --optimizeLevel 3 --shrinkLevel 0 -o build/swar-port/string.wasm",
    "test:swar-port:string": "npm run build:swar-port:string && node ./assembly/__tests__/swar-string.test.mjs && npm run test:swar-port:string:simd",
    "test:swar-port:string:simd": "asc assembly/__tests__/simd-string.ts --runtime stub --exportRuntime --enable simd --optimizeLevel 3 --shrinkLevel 0 -o build/swar-port/simd-string.wasm && node ./assembly/__tests__/simd-string.test.mjs",
    "bench:swar-port:string": "npm run build:swar-port:string && node ./assembly/__tests__/swar-string.bench.mjs",
    "build:swar-port:integer": "asc assembly/__tests__/swar-integer.ts --runtime stub --exportRuntime --optimizeLevel 3 --shrinkLevel 0 -o build/swar-port/integer.wasm",
    "test:swar-port:integer": "npm run build:swar-port:integer && node ./assembly/__tests__/swar-integer.test.mjs",
    "bench:swar-port:integer": "npm run build:swar-port:integer && node ./assembly/__tests__/swar-integer.bench.mjs",
    "build:swar-port:float": "asc assembly/__tests__/swar-float.ts --runtime stub --exportRuntime --optimizeLevel 3 --shrinkLevel 0 -o build/swar-port/float.wasm",
    "test:swar-port:float": "npm run build:swar-port:float && node ./assembly/__tests__/swar-float.test.mjs",
    "bench:swar-port:float": "npm run build:swar-port:float && node ./assembly/__tests__/swar-float.bench.mjs",
    "build:swar-port:arrays": "asc assembly/__tests__/swar-arrays.ts --runtime stub --exportRuntime --optimizeLevel 3 --shrinkLevel 0 -o build/swar-port/arrays.wasm",
    "test:swar-port:arrays": "npm run build:swar-port:arrays && node ./assembly/__tests__/swar-arrays.test.mjs",
    "bench:swar-port:arrays": "npm run build:swar-port:arrays && node ./assembly/__tests__/swar-arrays.bench.mjs",
    "build:swar-port:document": "asc assembly/__tests__/swar-document.ts --runtime stub --exportRuntime --optimizeLevel 3 --shrinkLevel 0 -o build/swar-port/document.wasm",
    "test:swar-port:document": "npm run build:swar-port:document && node ./assembly/__tests__/swar-document.test.mjs",
    "bench:swar-port:document": "npm run build:swar-port:document && node ./assembly/__tests__/swar-document.bench.mjs",
    "build:swar-port:serialize-string": "asc assembly/__tests__/swar-serialize-string.ts --runtime stub --exportRuntime --optimizeLevel 3 --shrinkLevel 0 -o build/swar-port/serialize-string.wasm",
    "test:swar-port:serialize-string": "npm run build:swar-port:serialize-string && node ./assembly/__tests__/swar-serialize-string.test.mjs && npm run test:swar-port:serialize-string:simd",
    "test:swar-port:serialize-string:simd": "asc assembly/__tests__/simd-serialize-string.ts --runtime stub --exportRuntime --enable simd --optimizeLevel 3 --shrinkLevel 0 -o build/swar-port/simd-serialize-string.wasm && node ./assembly/__tests__/simd-serialize-string.test.mjs",
    "bench:swar-port:serialize-string": "npm run build:swar-port:serialize-string && node ./assembly/__tests__/swar-serialize-string.bench.mjs",
    "test:fuzz:raw": "npm run build:raw && node ./src/raw/fuzz.test.mjs",
    "test:fuzz:raw:tiers": "npm run test:fuzz:raw:naive && npm run test:fuzz:raw:swar && npm run test:fuzz:raw:simd",
    "test:fuzz:raw:naive": "JSON_TY_KERNEL_TIER=naive npm run test:fuzz:raw",
    "test:fuzz:raw:swar": "JSON_TY_KERNEL_TIER=swar npm run test:fuzz:raw",
    "test:fuzz:raw:simd": "JSON_TY_KERNEL_TIER=simd npm run test:fuzz:raw",
    "test:fuzz:raw:scalar": "npm run test:fuzz:raw:swar",
    "format": "prettier -w .",
    "prepack": "npm run build"
  },
  "type": "module"
}
