{
  "targets": {
    "release": {
      "outFile": "build/bridge.wasm",
      "optimizeLevel": 3,
      "shrinkLevel": 0,
      "converge": false,
      "noAssert": true
    }
  },
  "options": {
    "bindings": "raw",
    "runtime": "stub",
    "exportRuntime": true,
    "enable": ["simd", "bulk-memory"]
  }
}
